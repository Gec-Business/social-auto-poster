# ── Site ──────────────────────────────────────────────────────
# Public URL of your deployed site (Netlify sets this automatically)
# URL=https://your-site.netlify.app

# Link to include in every caption (your landing page / product page)
CAMPAIGN_LINK=https://your-site.com

# Timezone for campaign day calculation (IANA format)
TIMEZONE=UTC

# ── Authentication ────────────────────────────────────────────
# Dashboard login password
ADMIN_PASSWORD=change-me-to-something-secure

# iron-session secret (min 32 chars)
SESSION_SECRET=generate-a-random-string-at-least-32-characters-long

# ── Cron ──────────────────────────────────────────────────────
# Shared secret between Netlify scheduled function and the cron API
CRON_SECRET=generate-another-random-string

# ── Facebook / Instagram (Meta Graph API) ─────────────────────
# Get these from https://developers.facebook.com/tools/explorer/
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_ACCOUNT_ID=

# ── LinkedIn (OAuth 2.0) ─────────────────────────────────────
# Create an app at https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ID=

# ── Optional ──────────────────────────────────────────────────
# CDN base URL for your image assets (default: public/ folder)
# NEXT_PUBLIC_ASSET_CDN=https://your-cdn.netlify.app
